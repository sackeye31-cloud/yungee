<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
  <title>AfroDownload • upload & stream</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #0b081a;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
      flex-direction: column;
    }
    .run-wrapper {
      max-width: 430px;
      width: 100%;
      margin-bottom: 20px;
      display: flex;
      justify-content: center;
    }
    .run-btn {
      background: linear-gradient(135deg, #ff2f92, #8b2cff);
      border: none;
      padding: 18px 48px;
      border-radius: 60px;
      color: white;
      font-weight: 700;
      font-size: 1.4rem;
      cursor: pointer;
      box-shadow: 0 0 40px #8b2cff88, 0 8px 32px rgba(0,0,0,0.6);
      transition: 0.3s;
      letter-spacing: 0.5px;
      display: inline-flex;
      align-items: center;
      gap: 16px;
      animation: pulse 2s infinite;
      width: 100%;
      justify-content: center;
    }
    .run-btn:hover { transform: scale(1.05); box-shadow: 0 0 60px #ff2f92aa, 0 8px 32px rgba(0,0,0,0.6); }
    .run-btn i { font-size: 1.6rem; }
    @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.02); } 100% { transform: scale(1); } }
    .app-container {
      max-width: 430px;
      width: 100%;
      background: #080712;
      border-radius: 32px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
      overflow: hidden;
      position: relative;
      height: 780px;
      display: none;
      flex-direction: column;
      transition: all 0.3s ease;
    }
    .app-container.open { display: flex; }
    .screens {
      flex: 1;
      overflow-y: auto;
      padding: 16px 16px 80px 16px;
      scroll-behavior: smooth;
    }
    .screen { display: none; animation: fadeUp 0.25s ease; }
    .screen.active { display: block; }
    @keyframes fadeUp { 0% { opacity: 0; transform: translateY(12px); } 100% { opacity: 1; transform: translateY(0); } }
    #splash {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      text-align: center;
      padding: 20px;
      background: #080712;
    }
    #splash .logo-icon { font-size: 72px; color: #ff2f92; margin-bottom: 8px; filter: drop-shadow(0 0 20px #8b2cff66); }
    #splash h1 {
      font-size: 2.8rem;
      font-weight: 700;
      background: linear-gradient(135deg, #ff2f92, #8b2cff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.5px;
    }
    #splash .tagline { font-size: 1.2rem; color: #ff8a2a; font-weight: 500; margin-top: 4px; }
    #splash .sub { color: #9a3b5f; margin-top: 16px; font-weight: 400; letter-spacing: 2px; }
    .bottom-nav {
      background: #151122;
      backdrop-filter: blur(4px);
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding: 8px 8px 12px 8px;
      border-top: 1px solid #2a1f3a;
      flex-shrink: 0;
    }
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #9a3b5f;
      font-size: 12px;
      transition: 0.2s;
      cursor: pointer;
      padding: 4px 12px;
      border-radius: 30px;
    }
    .nav-item i { font-size: 22px; margin-bottom: 2px; }
    .nav-item.active { color: #ff2f92; font-weight: 600; }
    .nav-item.active i { text-shadow: 0 0 16px #ff2f92; }
    .section-title {
      color: white;
      font-weight: 600;
      font-size: 1.2rem;
      margin: 20px 0 12px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .card-row {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding-bottom: 8px;
      scrollbar-width: thin;
    }
    .card-row::-webkit-scrollbar { height: 3px; background: #1f1830; }
    .card-row::-webkit-scrollbar-thumb { background: #ff2f92; border-radius: 10px; }
    .song-card {
      background: #151122;
      border-radius: 20px;
      padding: 12px;
      min-width: 140px;
      max-width: 160px;
      flex-shrink: 0;
      box-shadow: 0 6px 12px rgba(0,0,0,0.5);
      transition: 0.2s;
    }
    .song-card .cover {
      width: 100%;
      aspect-ratio: 1/1;
      background: linear-gradient(145deg, #2a1f3a, #1b142b);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #9a3b5f;
      font-size: 32px;
      margin-bottom: 8px;
    }
    .song-card .title { color: white; font-weight: 600; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .song-card .artist { color: #9a3b5f; font-size: 0.75rem; }
    .song-card .actions { display: flex; justify-content: space-between; margin-top: 8px; align-items: center; }
    .btn-icon { background: none; border: none; color: #ff2f92; font-size: 18px; cursor: pointer; padding: 4px; }
    .btn-icon:hover { transform: scale(1.1); }
    .btn-icon.delete-btn { color: #ff4444; }
    .btn-icon.delete-btn:hover { color: #ff0000; }
    .btn-primary {
      background: linear-gradient(135deg, #ff2f92, #8b2cff);
      border: none;
      padding: 8px 20px;
      border-radius: 40px;
      color: white;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: 0.2s;
    }
    .btn-primary:hover { opacity: 0.8; transform: scale(0.97); }
    .search-bar {
      background: #151122;
      border-radius: 40px;
      padding: 10px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      border: 1px solid #2a1f3a;
    }
    .search-bar input { background: transparent; border: none; color: white; width: 100%; outline: none; font-size: 1rem; }
    .search-bar input::placeholder { color: #9a3b5f; }
    .filter-tabs {
      display: flex;
      gap: 10px;
      margin: 16px 0;
      flex-wrap: wrap;
    }
    .filter-tabs span {
      background: #151122;
      padding: 6px 16px;
      border-radius: 40px;
      color: #9a3b5f;
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
    }
    .filter-tabs span.active { background: #ff2f92; color: white; }
    .music-player {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: #080712;
      z-index: 999;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px 20px;
    }
    .music-player.open { display: flex; }
    .player-art {
      width: 240px;
      height: 240px;
      background: linear-gradient(145deg, #2a1f3a, #1b142b);
      border-radius: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 72px;
      color: #ff2f92;
      margin-bottom: 20px;
    }
    .player-title { color: white; font-size: 1.6rem; font-weight: 700; }
    .player-artist { color: #9a3b5f; font-size: 1rem; margin-bottom: 12px; }
    .progress-container {
      width: 100%;
      max-width: 300px;
      display: flex;
      align-items: center;
      gap: 10px;
      color: #9a3b5f;
      font-size: 0.75rem;
    }
    .progress-bar {
      flex: 1;
      height: 4px;
      background: #2a1f3a;
      border-radius: 10px;
      appearance: none;
    }
    .progress-bar::-webkit-slider-thumb { appearance: none; width: 12px; height: 12px; background: #ff2f92; border-radius: 50%; cursor: pointer; }
    .player-controls {
      display: flex;
      gap: 28px;
      align-items: center;
      margin: 20px 0;
    }
    .player-controls button { background: none; border: none; color: white; font-size: 28px; cursor: pointer; }
    .player-controls .play-btn {
      background: #ff2f92;
      width: 64px;
      height: 64px;
      border-radius: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 30px;
      box-shadow: 0 0 24px #ff2f9266;
    }
    .player-extra {
      display: flex;
      gap: 30px;
      margin-top: 12px;
      color: #9a3b5f;
    }
    .player-extra button { background: none; border: none; color: #9a3b5f; font-size: 18px; cursor: pointer; }
    .close-player { position: absolute; top: 24px; right: 24px; background: none; border: none; color: white; font-size: 28px; cursor: pointer; }
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(4px);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: #151122;
      max-width: 340px;
      width: 100%;
      border-radius: 32px;
      padding: 24px;
      color: white;
      animation: fadeUp 0.3s;
    }
    .modal h3 { margin-bottom: 6px; }
    .modal .sub { color: #9a3b5f; margin-bottom: 16px; }
    .quality-option { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #2a1f3a; }
    .lib-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 12px;
    }
    .lib-card { background: #151122; border-radius: 20px; padding: 16px; text-align: center; }
    .lib-card i { font-size: 32px; color: #ff2f92; }
    .profile-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 12px 0;
    }
    .profile-avatar {
      width: 72px; height: 72px;
      background: #2a1f3a;
      border-radius: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      color: #ff2f92;
    }
    .stats {
      display: flex;
      gap: 20px;
      margin: 16px 0;
    }
    .stats div { text-align: center; color: white; }
    .stats span { color: #9a3b5f; font-size: 0.75rem; }
    .menu-item {
      padding: 14px 0;
      border-bottom: 1px solid #1f1830;
      color: white;
      display: flex;
      justify-content: space-between;
    }
    .toast {
      position: fixed;
      bottom: 100px;
      left: 20px;
      right: 20px;
      background: #151122;
      color: white;
      padding: 12px 20px;
      border-radius: 40px;
      text-align: center;
      max-width: 400px;
      margin: 0 auto;
      border-left: 4px solid #ff2f92;
      display: none;
      z-index: 2000;
    }
    .toast.show { display: block; }
    .flex-between { display: flex; justify-content: space-between; align-items: center; }
    .mt-8 { margin-top: 8px; }
    .mb-8 { margin-bottom: 8px; }
    .gap-8 { gap: 8px; }
    .text-muted { color: #9a3b5f; }
    .upload-area {
      background: #151122;
      border: 2px dashed #2a1f3a;
      border-radius: 24px;
      padding: 24px 16px;
      text-align: center;
      margin: 16px 0;
      transition: 0.3s;
    }
    .upload-area.dragover { border-color: #ff2f92; background: #1f1830; }
    .upload-area i { font-size: 48px; color: #ff2f92; margin-bottom: 8px; }
    .upload-area p { color: #9a3b5f; margin-bottom: 12px; }
    .upload-area input[type="file"] { display: none; }
    .upload-progress {
      width: 100%;
      height: 4px;
      background: #2a1f3a;
      border-radius: 10px;
      margin: 12px 0;
      display: none;
    }
    .upload-progress .bar {
      height: 100%;
      background: linear-gradient(90deg, #ff2f92, #8b2cff);
      border-radius: 10px;
      width: 0%;
      transition: width 0.3s;
    }
    .uploaded-songs {
      margin-top: 12px;
    }
    .uploaded-song {
      background: #1f1830;
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: white;
    }
    .uploaded-song .info { flex: 1; }
    .uploaded-song .info .title { font-weight: 600; }
    .uploaded-song .info .artist { font-size: 0.75rem; color: #9a3b5f; }
    .uploaded-song .actions button { color: #9a3b5f; margin-left: 8px; }
    .uploaded-song .actions .delete-upload-btn { color: #ff4444; }
    .uploaded-song .actions .delete-upload-btn:hover { color: #ff0000; }
  </style>
</head>
<body>
  <!-- RUN BUTTON -->
  <div class="run-wrapper">
    <button class="run-btn" id="runAppBtn">
      <i class="fas fa-play"></i> Launch AfroDownload
    </button>
  </div>

  <!-- APP CONTAINER -->
  <div class="app-container" id="app">
    <!-- splash -->
    <div id="splash" class="screen active">
      <div class="logo-icon"><i class="fas fa-music"></i></div>
      <h1>AfroDownload</h1>
      <div class="tagline">Discover. Stream. Download.</div>
      <div class="sub">Afro music. Our sound. Our pride.</div>
    </div>

    <!-- screens -->
    <div class="screens" id="screensContainer">
      <!-- HOME -->
      <div id="home" class="screen">
        <div class="flex-between"><div><h2 style="color:white;">Hello, Emmanuel</h2><span class="text-muted">What are you listening to?</span></div><i class="fas fa-bell" style="color:#ff2f92;font-size:22px;"></i></div>
        
        <!-- UPLOAD AREA -->
        <div class="upload-area" id="uploadArea">
          <i class="fas fa-cloud-upload-alt"></i>
          <p>Upload your own Afrobeat</p>
          <button class="btn-primary" id="uploadBtn">Choose File</button>
          <input type="file" id="fileInput" accept="audio/*" multiple />
          <div class="upload-progress" id="uploadProgress"><div class="bar" id="progressBarUpload"></div></div>
        </div>
        
        <div class="section-title">New Release <span class="text-muted" style="font-size:0.8rem;">See all</span></div>
        <div class="card-row" id="newReleaseRow"></div>
        <div class="section-title">Trending Now</div>
        <div class="card-row" id="trendingRow"></div>
        <div class="section-title">Recommended for You</div>
        <div class="card-row" id="recommendedRow"></div>
        <div class="section-title">Your Uploads <span class="text-muted" style="font-size:0.8rem;" id="uploadCount">0</span></div>
        <div class="card-row" id="uploadRow"></div>
      </div>

      <!-- SEARCH -->
      <div id="search" class="screen">
        <div class="search-bar"><i class="fas fa-search" style="color:#9a3b5f;"></i><input type="text" id="searchInput" placeholder="Search songs, artists, albums..."></div>
        <div class="filter-tabs" id="filterTabs"><span class="active" data-filter="all">All</span><span data-filter="songs">Songs</span><span data-filter="artists">Artists</span><span data-filter="albums">Albums</span><span data-filter="playlists">Playlists</span></div>
        <div id="searchResults"></div>
      </div>

      <!-- LIBRARY -->
      <div id="library" class="screen">
        <h2 style="color:white;">Library</h2>
        <div class="lib-grid">
          <div class="lib-card"><i class="fas fa-heart"></i><div>Favorites</div><span class="text-muted" id="favCount">0</span></div>
          <div class="lib-card"><i class="fas fa-list"></i><div>Playlists</div><span class="text-muted" id="playlistCount">0</span></div>
          <div class="lib-card"><i class="fas fa-clock"></i><div>Recently Played</div></div>
          <div class="lib-card"><i class="fas fa-compact-disc"></i><div>Albums</div></div>
          <div class="lib-card"><i class="fas fa-user"></i><div>Artists</div></div>
          <div class="lib-card"><i class="fas fa-upload"></i><div>Uploads</div><span class="text-muted" id="uploadLibCount">0</span></div>
        </div>
        <div class="section-title">Favorites</div>
        <div id="favoritesList"></div>
      </div>

      <!-- DOWNLOADS -->
      <div id="downloads" class="screen">
        <h2 style="color:white;">My Downloads</h2>
        <div class="flex-between text-muted"><span id="downloadCount">0 songs</span><span id="storageEstimate">0 MB</span></div>
        <div id="downloadsList"></div>
      </div>

      <!-- PROFILE -->
      <div id="profile" class="screen">
        <div class="profile-header"><div class="profile-avatar"><i class="fas fa-user"></i></div><div><h3 style="color:white;">Emmanuel Sackey</h3><span class="text-muted">@emmanuelsackey <i class="fas fa-check-circle" style="color:#ff2f92;"></i></span></div></div>
        <div class="stats"><div><div>12</div><span>Playlists</span></div><div><div id="profileFavs">0</div><span>Favorites</span></div><div><div id="profileDownloads">0</div><span>Downloads</span></div><div><div id="profileUploads">0</div><span>Uploads</span></div></div>
        <div class="menu-item">Account <i class="fas fa-chevron-right text-muted"></i></div>
        <div class="menu-item">Subscription <i class="fas fa-chevron-right text-muted"></i></div>
        <div class="menu-item">Download Quality <i class="fas fa-chevron-right text-muted"></i></div>
        <div class="menu-item">Payment Methods <i class="fas fa-chevron-right text-muted"></i></div>
        <div class="menu-item">Help & Support <i class="fas fa-chevron-right text-muted"></i></div>
        <div class="menu-item">About AfroDownload <i class="fas fa-chevron-right text-muted"></i></div>
        <div class="menu-item" style="color:#ff2f92;">Log Out</div>
      </div>
    </div>

    <!-- bottom nav -->
    <div class="bottom-nav" id="bottomNav">
      <div class="nav-item active" data-screen="home"><i class="fas fa-home"></i><span>Home</span></div>
      <div class="nav-item" data-screen="search"><i class="fas fa-search"></i><span>Search</span></div>
      <div class="nav-item" data-screen="library"><i class="fas fa-book"></i><span>Library</span></div>
      <div class="nav-item" data-screen="downloads"><i class="fas fa-download"></i><span>Downloads</span></div>
      <div class="nav-item" data-screen="profile"><i class="fas fa-user"></i><span>Profile</span></div>
    </div>

    <!-- music player overlay -->
    <div class="music-player" id="musicPlayer">
      <button class="close-player" id="closePlayer"><i class="fas fa-times"></i></button>
      <div class="player-art" id="playerArt"><i class="fas fa-music"></i></div>
      <div class="player-title" id="playerTitle">Song Title</div>
      <div class="player-artist" id="playerArtist">Artist</div>
      <div class="progress-container"><span id="currentTime">0:00</span><input type="range" class="progress-bar" id="progressBar" min="0" max="100" value="0"><span id="totalDuration">3:30</span></div>
      <div class="player-controls">
        <button id="shuffleBtn"><i class="fas fa-random"></i></button>
        <button id="prevBtn"><i class="fas fa-step-backward"></i></button>
        <button class="play-btn" id="playerPlayBtn"><i class="fas fa-play"></i></button>
        <button id="nextBtn"><i class="fas fa-step-forward"></i></button>
        <button id="repeatBtn"><i class="fas fa-redo"></i></button>
      </div>
      <div class="player-extra">
        <button id="favBtn"><i class="far fa-heart"></i></button>
        <button id="lyricsBtn"><i class="fas fa-scroll"></i></button>
        <button id="addPlaylistBtn"><i class="fas fa-plus-circle"></i></button>
        <button id="downloadBtn"><i class="fas fa-download"></i></button>
      </div>
    </div>

    <!-- download modal -->
    <div class="modal-overlay" id="downloadModal">
      <div class="modal">
        <h3 id="modalSongTitle">Song</h3>
        <div class="sub" id="modalArtist">Artist</div>
        <div class="quality-option" data-quality="high">High - 320 kbps <span>~8 MB</span></div>
        <div class="quality-option" data-quality="medium">Medium - 192 kbps <span>~5 MB</span></div>
        <div class="quality-option" data-quality="low">Low - 128 kbps <span>~3 MB</span></div>
        <button class="btn-primary" style="width:100%;margin-top:16px;" id="confirmDownloadBtn">Download</button>
        <button style="background:none;border:none;color:#9a3b5f;margin-top:8px;width:100%;" id="closeModalBtn">Cancel</button>
      </div>
    </div>

    <!-- toast -->
    <div class="toast" id="toast"></div>
  </div>

<script>
  (function(){
    // ----- DATA -----
    let songs = [
      { id: 1, title: "Sika Aba Fie", artist: "Kweku Darlington", cover: "🎵", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3", duration: "3:28", album: "Sika Aba Fie", category: "Afrobeats", isUpload: false },
      { id: 2, title: "Odo Nti", artist: "Stonebwoy", cover: "🎶", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3", duration: "3:45", album: "Anloga Junction", category: "Reggae", isUpload: false },
      { id: 3, title: "Jerusalema", artist: "Master KG", cover: "🎵", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3", duration: "3:52", album: "Jerusalema", category: "Afro House", isUpload: false },
      { id: 4, title: "Essence", artist: "Wizkid ft Tems", cover: "🎵", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3", duration: "4:08", album: "Made In Lagos", category: "Afrobeats", isUpload: false },
      { id: 5, title: "Kwaku The Traveller", artist: "Black Sherif", cover: "🎶", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3", duration: "3:05", album: "The Villain I Never Was", category: "Hip Hop", isUpload: false },
      { id: 6, title: "Love Nwantiti", artist: "CKay", cover: "🎵", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-6.mp3", duration: "3:20", album: "Boyfriend", category: "Afrobeats", isUpload: false },
    ];

    // ----- STATE -----
    let uploads = JSON.parse(localStorage.getItem('afroUploads')) || [];
    let favorites = JSON.parse(localStorage.getItem('afroFavorites')) || [];
    let downloads = JSON.parse(localStorage.getItem('afroDownloads')) || [];
    let currentSong = null;
    let audioPlayer = new Audio();
    let isPlaying = false;
    let currentPlaylist = [];
    let currentIndex = 0;
    let selectedQuality = 'high';

    // ----- DOM REFS -----
    const $ = (id) => document.getElementById(id);
    const app = $('app');
    const runBtn = $('runAppBtn');
    const splash = $('splash');
    const screens = ['home', 'search', 'library', 'downloads', 'profile'];
    const navItems = document.querySelectorAll('.nav-item');
    const toast = $('toast');
    let toastTimeout;

    // ----- TOAST -----
    function showToast(msg, duration = 2500) {
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => toast.classList.remove('show'), duration);
    }

    // ----- NAVIGATION -----
    function navigateTo(screenId) {
      screens.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('active', id === screenId);
      });
      navItems.forEach(item => {
        item.classList.toggle('active', item.dataset.screen === screenId);
      });
      if (screenId === 'home') renderHome();
      if (screenId === 'library') renderLibrary();
      if (screenId === 'downloads') renderDownloads();
      if (screenId === 'profile') updateProfileStats();
      if (screenId === 'search') renderSearchResults('');
    }

    navItems.forEach(item => {
      item.addEventListener('click', () => {
        navigateTo(item.dataset.screen);
      });
    });

    // ----- RENDER FUNCTIONS -----
    function createSongCard(song, rowId) {
      const card = document.createElement('div');
      card.className = 'song-card';
      card.dataset.id = song.id;
      card.innerHTML = `
        <div class="cover">${song.cover || '🎵'}</div>
        <div class="title">${song.title}</div>
        <div class="artist">${song.artist}</div>
        <div class="actions">
          <button class="btn-icon play-song-btn" data-id="${song.id}"><i class="fas fa-play"></i></button>
          <button class="btn-icon fav-btn" data-id="${song.id}"><i class="${favorites.includes(song.id) ? 'fas' : 'far'} fa-heart"></i></button>
          <button class="btn-icon download-btn" data-id="${song.id}"><i class="fas fa-download"></i></button>
          ${song.isUpload ? `<button class="btn-icon delete-btn delete-upload-btn" data-id="${song.id}"><i class="fas fa-trash"></i></button>` : ''}
        </div>
      `;
      return card;
    }

    function renderHome() {
      const newRelease = $('newReleaseRow');
      const trending = $('trendingRow');
      const recommended = $('recommendedRow');
      const uploadRow = $('uploadRow');
      const uploadCount = $('uploadCount');

      newRelease.innerHTML = '';
      trending.innerHTML = '';
      recommended.innerHTML = '';
      uploadRow.innerHTML = '';

      songs.slice(0, 4).forEach(s => {
        newRelease.appendChild(createSongCard(s, 'newRelease'));
      });

      songs.slice(2, 6).forEach(s => {
        trending.appendChild(createSongCard(s, 'trending'));
      });

      songs.slice(1, 5).forEach(s => {
        recommended.appendChild(createSongCard(s, 'recommended'));
      });

      // Uploads
      const allUploads = getAllSongs().filter(s => s.isUpload);
      uploadCount.textContent = allUploads.length;
      allUploads.forEach(s => {
        uploadRow.appendChild(createSongCard(s, 'upload'));
      });

      // Attach event listeners for cards
      attachCardEvents();
    }

    function getAllSongs() {
      return [...songs, ...uploads];
    }

    function getSongById(id) {
      return getAllSongs().find(s => s.id === id);
    }

    function renderLibrary() {
      const favList = $('favoritesList');
      favList.innerHTML = '';
      const favSongs = getAllSongs().filter(s => favorites.includes(s.id));
      favSongs.forEach(s => {
        const card = createSongCard(s, 'favorites');
        favList.appendChild(card);
      });
      $('favCount').textContent = favSongs.length;
      $('uploadLibCount').textContent = getAllSongs().filter(s => s.isUpload).length;
      attachCardEvents();
    }

    function renderDownloads() {
      const list = $('downloadsList');
      list.innerHTML = '';
      const downloadSongs = getAllSongs().filter(s => downloads.includes(s.id));
      downloadSongs.forEach(s => {
        const card = createSongCard(s, 'downloads');
        // Add a remove from downloads button
        const actions = card.querySelector('.actions');
        const removeBtn = document.createElement('button');
        removeBtn.className = 'btn-icon delete-btn';
        removeBtn.innerHTML = '<i class="fas fa-times"></i>';
        removeBtn.title = 'Remove from downloads';
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          removeFromDownloads(s.id);
        });
        actions.appendChild(removeBtn);
        list.appendChild(card);
      });
      $('downloadCount').textContent = downloadSongs.length + ' songs';
      const size = downloadSongs.length * 5;
      $('storageEstimate').textContent = size + ' MB';
      attachCardEvents();
    }

    function updateProfileStats() {
      const allSongs = getAllSongs();
      const favSongs = allSongs.filter(s => favorites.includes(s.id));
      const downloadSongs = allSongs.filter(s => downloads.includes(s.id));
      const uploadSongs = allSongs.filter(s => s.isUpload);
      $('profileFavs').textContent = favSongs.length;
      $('profileDownloads').textContent = downloadSongs.length;
      $('profileUploads').textContent = uploadSongs.length;
    }

    // ----- SEARCH -----
    function renderSearchResults(query) {
      const container = $('searchResults');
      container.innerHTML = '';
      if (!query.trim()) {
        container.innerHTML = '<p class="text-muted" style="text-align:center;padding:20px;">Search for your favorite Afrobeat...</p>';
        return;
      }
      const results = getAllSongs().filter(s => 
        s.title.toLowerCase().includes(query.toLowerCase()) ||
        s.artist.toLowerCase().includes(query.toLowerCase())
      );
      if (results.length === 0) {
        container.innerHTML = '<p class="text-muted" style="text-align:center;padding:20px;">No songs found. Try a different search.</p>';
        return;
      }
      results.forEach(s => {
        const card = createSongCard(s, 'search');
        container.appendChild(card);
      });
      attachCardEvents();
    }

    // ----- EVENT ATTACHMENT (delegated) -----
    function attachCardEvents() {
      document.querySelectorAll('.play-song-btn').forEach(btn => {
        btn.removeEventListener('click', handlePlayClick);
        btn.addEventListener('click', handlePlayClick);
      });
      document.querySelectorAll('.fav-btn').forEach(btn => {
        btn.removeEventListener('click', handleFavClick);
        btn.addEventListener('click', handleFavClick);
      });
      document.querySelectorAll('.download-btn').forEach(btn => {
        btn.removeEventListener('click', handleDownloadClick);
        btn.addEventListener('click', handleDownloadClick);
      });
      document.querySelectorAll('.delete-upload-btn').forEach(btn => {
        btn.removeEventListener('click', handleDeleteUpload);
        btn.addEventListener('click', handleDeleteUpload);
      });
    }

    function handlePlayClick(e) {
      e.stopPropagation();
      const id = parseInt(this.dataset.id);
      const song = getSongById(id);
      if (song) playSong(song);
    }

    function handleFavClick(e) {
      e.stopPropagation();
      const id = parseInt(this.dataset.id);
      toggleFavorite(id);
      // Update icon
      const icon = this.querySelector('i');
      if (favorites.includes(id)) {
        icon.className = 'fas fa-heart';
      } else {
        icon.className = 'far fa-heart';
      }
      updateProfileStats();
    }

    function handleDownloadClick(e) {
      e.stopPropagation();
      const id = parseInt(this.dataset.id);
      const song = getSongById(id);
      if (song) openDownloadModal(song);
    }

    function handleDeleteUpload(e) {
      e.stopPropagation();
      const id = parseInt(this.dataset.id);
      deleteUpload(id);
    }

    // ----- FAVORITES -----
    function toggleFavorite(id) {
      const index = favorites.indexOf(id);
      if (index > -1) {
        favorites.splice(index, 1);
        showToast('Removed from favorites');
      } else {
        favorites.push(id);
        showToast('Added to favorites ❤️');
      }
      localStorage.setItem('afroFavorites', JSON.stringify(favorites));
      renderHome();
      renderLibrary();
      updateProfileStats();
    }

    // ----- DOWNLOADS -----
    function openDownloadModal(song) {
      $('modalSongTitle').textContent = song.title;
      $('modalArtist').textContent = song.artist;
      $('downloadModal').classList.add('open');
      currentSong = song;
    }

    function closeDownloadModal() {
      $('downloadModal').classList.remove('open');
    }

    document.querySelectorAll('.quality-option').forEach(el => {
      el.addEventListener('click', function() {
        document.querySelectorAll('.quality-option').forEach(opt => opt.style.border = 'none');
        this.style.border = '2px solid #ff2f92';
        this.style.borderRadius = '8px';
        selectedQuality = this.dataset.quality;
      });
    });

    $('confirmDownloadBtn').addEventListener('click', function() {
      if (!currentSong) return;
      if (!downloads.includes(currentSong.id)) {
        downloads.push(currentSong.id);
        localStorage.setItem('afroDownloads', JSON.stringify(downloads));
        showToast(`Downloading ${currentSong.title} (${selectedQuality} quality)`);
        // Simulate download
        setTimeout(() => {
          showToast(`✅ ${currentSong.title} downloaded!`);
          renderDownloads();
          updateProfileStats();
        }, 1500);
      } else {
        showToast('Already downloaded');
      }
      closeDownloadModal();
    });

    function removeFromDownloads(id) {
      const index = downloads.indexOf(id);
      if (index > -1) {
        downloads.splice(index, 1);
        localStorage.setItem('afroDownloads', JSON.stringify(downloads));
        showToast('Removed from downloads');
        renderDownloads();
        updateProfileStats();
      }
    }

    $('closeModalBtn').addEventListener('click', closeDownloadModal);
    $('downloadModal').addEventListener('click', function(e) {
      if (e.target === this) closeDownloadModal();
    });

    // ----- UPLOAD -----
    const fileInput = $('fileInput');
    const uploadBtn = $('uploadBtn');
    const uploadArea = $('uploadArea');
    const progressBar = $('progressBarUpload');
    const progressContainer = $('uploadProgress');

    uploadBtn.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', function(e) {
      const files = Array.from(this.files);
      if (files.length === 0) return;
      files.forEach(file => {
        if (file.type.startsWith('audio/')) {
          uploadFile(file);
        } else {
          showToast('Please select an audio file');
        }
      });
      this.value = '';
    });

    // Drag and drop
    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('dragover');
    });
    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('dragover');
    });
    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('dragover');
      const files = Array.from(e.dataTransfer.files);
      files.forEach(file => {
        if (file.type.startsWith('audio/')) {
          uploadFile(file);
        } else {
          showToast('Please drop an audio file');
        }
      });
    });

    function uploadFile(file) {
      progressContainer.style.display = 'block';
      let progress = 0;
      const interval = setInterval(() => {
        progress += 5;
        progressBar.style.width = progress + '%';
        if (progress >= 100) {
          clearInterval(interval);
          // Create song object
          const newSong = {
            id: Date.now() + Math.random() * 1000,
            title: file.name.replace(/\.[^/.]+$/, ''),
            artist: 'Uploaded Artist',
            cover: '🎵',
            audio: URL.createObjectURL(file),
            duration: '3:00',
            album: 'Uploads',
            category: 'Upload',
            isUpload: true,
            file: file
          };
          uploads.push(newSong);
          localStorage.setItem('afroUploads', JSON.stringify(uploads));
          setTimeout(() => {
            progressContainer.style.display = 'none';
            progressBar.style.width = '0%';
            showToast(`✅ ${newSong.title} uploaded!`);
            renderHome();
            updateProfileStats();
          }, 300);
        }
      }, 100);
    }

    // ----- DELETE UPLOAD -----
    function deleteUpload(id) {
      if (confirm('Are you sure you want to delete this upload?')) {
        const index = uploads.findIndex(s => s.id === id);
        if (index > -1) {
          // Revoke object URL to free memory
          if (uploads[index].audio && uploads[index].audio.startsWith('blob:')) {
            URL.revokeObjectURL(uploads[index].audio);
          }
          uploads.splice(index, 1);
          localStorage.setItem('afroUploads', JSON.stringify(uploads));
          showToast('Upload deleted');
          renderHome();
          renderLibrary();
          updateProfileStats();
        }
      }
    }

    // ----- MUSIC PLAYER -----
    function playSong(song) {
      currentSong = song;
      $('playerTitle').textContent = song.title;
      $('playerArtist').textContent = song.artist;
      $('playerArt').innerHTML = `<i class="fas fa-music"></i>`;
      
      if (audioPlayer.src !== song.audio) {
        audioPlayer.src = song.audio;
        audioPlayer.load();
      }
      
      audioPlayer.play().then(() => {
        isPlaying = true;
        $('playerPlayBtn').innerHTML = '<i class="fas fa-pause"></i>';
      }).catch(err => {
        console.log('Playback error:', err);
        // Fallback: try to play anyway
        audioPlayer.play();
      });
      
      $('musicPlayer').classList.add('open');
      
      // Update fav button
      const favBtn = $('favBtn');
      if (favorites.includes(song.id)) {
        favBtn.innerHTML = '<i class="fas fa-heart" style="color:#ff2f92;"></i>';
      } else {
        favBtn.innerHTML = '<i class="far fa-heart"></i>';
      }
      
      // Set playlist
      currentPlaylist = getAllSongs();
      currentIndex = currentPlaylist.findIndex(s => s.id === song.id);
      if (currentIndex === -1) currentIndex = 0;
    }

    // Player controls
    $('playerPlayBtn').addEventListener('click', function() {
      if (isPlaying) {
        audioPlayer.pause();
        this.innerHTML = '<i class="fas fa-play"></i>';
      } else {
        audioPlayer.play();
        this.innerHTML = '<i class="fas fa-pause"></i>';
      }
      isPlaying = !isPlaying;
    });

    audioPlayer.addEventListener('timeupdate', function() {
      if (this.duration) {
        const percent = (this.currentTime / this.duration) * 100;
        $('progressBar').value = percent;
        $('currentTime').textContent = formatTime(this.currentTime);
        $('totalDuration').textContent = formatTime(this.duration);
      }
    });

    $('progressBar').addEventListener('input', function() {
      if (audioPlayer.duration) {
        audioPlayer.currentTime = (this.value / 100) * audioPlayer.duration;
      }
    });

    audioPlayer.addEventListener('ended', function() {
      // Auto play next
      if (currentPlaylist.length > 0) {
        const nextIndex = (currentIndex + 1) % currentPlaylist.length;
        currentIndex = nextIndex;
        playSong(currentPlaylist[nextIndex]);
      }
    });

    $('nextBtn').addEventListener('click', function() {
      if (currentPlaylist.length > 0) {
        const nextIndex = (currentIndex + 1) % currentPlaylist.length;
        currentIndex = nextIndex;
        playSong(currentPlaylist[nextIndex]);
      }
    });

    $('prevBtn').addEventListener('click', function() {
      if (currentPlaylist.length > 0) {
        const prevIndex = (currentIndex - 1 + currentPlaylist.length) % currentPlaylist.length;
        currentIndex = prevIndex;
        playSong(currentPlaylist[prevIndex]);
      }
    });

    $('closePlayer').addEventListener('click', function() {
      $('musicPlayer').classList.remove('open');
      audioPlayer.pause();
      isPlaying = false;
      $('playerPlayBtn').innerHTML = '<i class="fas fa-play"></i>';
    });

    // Fav in player
    $('favBtn').addEventListener('click', function() {
      if (!currentSong) return;
      toggleFavorite(currentSong.id);
      if (favorites.includes(currentSong.id)) {
        this.innerHTML = '<i class="fas fa-heart" style="color:#ff2f92;"></i>';
      } else {
        this.innerHTML = '<i class="far fa-heart"></i>';
      }
    });

    // Download in player
    $('downloadBtn').addEventListener('click', function() {
      if (currentSong) openDownloadModal(currentSong);
    });

    // ----- FORMAT TIME -----
    function formatTime(seconds) {
      if (!seconds || isNaN(seconds)) return '0:00';
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs.toString().padStart(2, '0')}`;
    }

    // ----- SEARCH INPUT -----
    const searchInput = $('searchInput');
    let searchTimeout;
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        renderSearchResults(this.value);
      }, 300);
    });

    // Filter tabs
    document.querySelectorAll('#filterTabs span').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('#filterTabs span').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        // Simple filter - just re-render with filter
        const query = searchInput.value;
        const filter = this.dataset.filter;
        const container = $('searchResults');
        container.innerHTML = '';
        if (!query.trim()) {
          container.innerHTML = '<p class="text-muted" style="text-align:center;padding:20px;">Search for your favorite Afrobeat...</p>';
          return;
        }
        let results = getAllSongs().filter(s => 
          s.title.toLowerCase().includes(query.toLowerCase()) ||
          s.artist.toLowerCase().includes(query.toLowerCase())
        );
        if (filter === 'songs') {
          // Just show all songs (default)
        } else if (filter === 'artists') {
          // Group by artist - just show unique artists
          const artists = [...new Set(results.map(s => s.artist))];
          container.innerHTML = artists.map(a => 
            `<div style="color:white;padding:10px;background:#151122;border-radius:12px;margin:4px 0;">🎤 ${a}</div>`
          ).join('');
          return;
        } else if (filter === 'albums') {
          const albums = [...new Set(results.map(s => s.album))];
          container.innerHTML = albums.map(a => 
            `<div style="color:white;padding:10px;background:#151122;border-radius:12px;margin:4px 0;">💿 ${a}</div>`
          ).join('');
          return;
        }
        // Default: show songs
        results.forEach(s => {
          const card = createSongCard(s, 'search');
          container.appendChild(card);
        });
        attachCardEvents();
      });
    });

    // ----- LAUNCH APP -----
    runBtn.addEventListener('click', function() {
      app.classList.add('open');
      this.style.display = 'none';
      // Auto navigate to home after splash
      setTimeout(() => {
        splash.classList.remove('active');
        navigateTo('home');
      }, 800);
      renderHome();
      updateProfileStats();
    });

    // ----- INIT -----
    // Load data from localStorage
    renderHome();
    updateProfileStats();

    // Global keyboard shortcut: Escape to close player
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if ($('musicPlayer').classList.contains('open')) {
          $('closePlayer').click();
        }
        if ($('downloadModal').classList.contains('open')) {
          closeDownloadModal();
        }
      }
    });

    console.log('🎵 AfroDownload loaded successfully!');
    console.log(`📊 ${getAllSongs().length} songs available`);
    console.log(`❤️ ${favorites.length} favorites`);
    console.log(`⬇️ ${downloads.length} downloads`);
    console.log(`⬆️ ${uploads.length} uploads`);
  })();
</script>
</body>
</html>
