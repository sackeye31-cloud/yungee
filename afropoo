<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
  <title>AfroDownload • upload & stream</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #0b081a;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
      flex-direction: column;
    }
    .run-wrapper {
      max-width: 430px;
      width: 100%;
      margin-bottom: 20px;
      display: flex;
      justify-content: center;
    }
    .run-btn {
      background: linear-gradient(135deg, #ff2f92, #8b2cff);
      border: none;
      padding: 18px 48px;
      border-radius: 60px;
      color: white;
      font-weight: 700;
      font-size: 1.4rem;
      cursor: pointer;
      box-shadow: 0 0 40px #8b2cff88, 0 8px 32px rgba(0,0,0,0.6);
      transition: 0.3s;
      letter-spacing: 0.5px;
      display: inline-flex;
      align-items: center;
      gap: 16px;
      animation: pulse 2s infinite;
      width: 100%;
      justify-content: center;
    }
    .run-btn:hover { transform: scale(1.05); box-shadow: 0 0 60px #ff2f92aa, 0 8px 32px rgba(0,0,0,0.6); }
    .run-btn i { font-size: 1.6rem; }
    @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.02); } 100% { transform: scale(1); } }
    .app-container {
      max-width: 430px;
      width: 100%;
      background: #080712;
      border-radius: 32px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
      overflow: hidden;
      position: relative;
      height: 780px;
      display: none;
      flex-direction: column;
      transition: all 0.3s ease;
    }
    .app-container.open { display: flex; }
    .screens {
      flex: 1;
      overflow-y: auto;
      padding: 16px 16px 80px 16px;
      scroll-behavior: smooth;
    }
    .screen { display: none; animation: fadeUp 0.25s ease; }
    .screen.active { display: block; }
    @keyframes fadeUp { 0% { opacity: 0; transform: translateY(12px); } 100% { opacity: 1; transform: translateY(0); } }
    #splash {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      text-align: center;
      padding: 20px;
      background: #080712;
    }
    #splash .logo-icon { font-size: 72px; color: #ff2f92; margin-bottom: 8px; filter: drop-shadow(0 0 20px #8b2cff66); }
    #splash h1 {
      font-size: 2.8rem;
      font-weight: 700;
      background: linear-gradient(135deg, #ff2f92, #8b2cff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.5px;
    }
    #splash .tagline { font-size: 1.2rem; color: #ff8a2a; font-weight: 500; margin-top: 4px; }
    #splash .sub { color: #9a3b5f; margin-top: 16px; font-weight: 400; letter-spacing: 2px; }
    .bottom-nav {
      background: #151122;
      backdrop-filter: blur(4px);
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding: 8px 8px 12px 8px;
      border-top: 1px solid #2a1f3a;
      flex-shrink: 0;
    }
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #9a3b5f;
      font-size: 12px;
      transition: 0.2s;
      cursor: pointer;
      padding: 4px 12px;
      border-radius: 30px;
    }
    .nav-item i { font-size: 22px; margin-bottom: 2px; }
    .nav-item.active { color: #ff2f92; font-weight: 600; }
    .nav-item.active i { text-shadow: 0 0 16px #ff2f92; }
    .section-title {
      color: white;
      font-weight: 600;
      font-size: 1.2rem;
      margin: 20px 0 12px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .card-row {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding-bottom: 8px;
      scrollbar-width: thin;
    }
    .card-row::-webkit-scrollbar { height: 3px; background: #1f1830; }
    .card-row::-webkit-scrollbar-thumb { background: #ff2f92; border-radius: 10px; }
    .song-card {
      background: #151122;
      border-radius: 20px;
      padding: 12px;
      min-width: 140px;
      max-width: 160px;
      flex-shrink: 0;
      box-shadow: 0 6px 12px rgba(0,0,0,0.5);
      transition: 0.2s;
    }
    .song-card .cover {
      width: 100%;
      aspect-ratio: 1/1;
      background: linear-gradient(145deg, #2a1f3a, #1b142b);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #9a3b5f;
      font-size: 32px;
      margin-bottom: 8px;
    }
    .song-card .title { color: white; font-weight: 600; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .song-card .artist { color: #9a3b5f; font-size: 0.75rem; }
    .song-card .actions { display: flex; justify-content: space-between; margin-top: 8px; align-items: center; }
    .btn-icon { background: none; border: none; color: #ff2f92; font-size: 18px; cursor: pointer; padding: 4px; }
    .btn-icon:hover { transform: scale(1.1); }
    .btn-primary {
      background: linear-gradient(135deg, #ff2f92, #8b2cff);
      border: none;
      padding: 8px 20px;
      border-radius: 40px;
      color: white;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: 0.2s;
    }
    .btn-primary:hover { opacity: 0.8; transform: scale(0.97); }
    .search-bar {
      background: #151122;
      border-radius: 40px;
      padding: 10px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      border: 1px solid #2a1f3a;
    }
    .search-bar input { background: transparent; border: none; color: white; width: 100%; outline: none; font-size: 1rem; }
    .search-bar input::placeholder { color: #9a3b5f; }
    .filter-tabs {
      display: flex;
      gap: 10px;
      margin: 16px 0;
      flex-wrap: wrap;
    }
    .filter-tabs span {
      background: #151122;
      padding: 6px 16px;
      border-radius: 40px;
      color: #9a3b5f;
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
    }
    .filter-tabs span.active { background: #ff2f92; color: white; }
    .music-player {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: #080712;
      z-index: 999;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px 20px;
    }
    .music-player.open { display: flex; }
    .player-art {
      width: 240px;
      height: 240px;
      background: linear-gradient(145deg, #2a1f3a, #1b142b);
      border-radius: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 72px;
      color: #ff2f92;
      margin-bottom: 20px;
    }
    .player-title { color: white; font-size: 1.6rem; font-weight: 700; }
    .player-artist { color: #9a3b5f; font-size: 1rem; margin-bottom: 12px; }
    .progress-container {
      width: 100%;
      max-width: 300px;
      display: flex;
      align-items: center;
      gap: 10px;
      color: #9a3b5f;
      font-size: 0.75rem;
    }
    .progress-bar {
      flex: 1;
      height: 4px;
      background: #2a1f3a;
      border-radius: 10px;
      appearance: none;
    }
    .progress-bar::-webkit-slider-thumb { appearance: none; width: 12px; height: 12px; background: #ff2f92; border-radius: 50%; cursor: pointer; }
    .player-controls {
      display: flex;
      gap: 28px;
      align-items: center;
      margin: 20px 0;
    }
    .player-controls button { background: none; border: none; color: white; font-size: 28px; cursor: pointer; }
    .player-controls .play-btn {
      background: #ff2f92;
      width: 64px;
      height: 64px;
      border-radius: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 30px;
      box-shadow: 0 0 24px #ff2f9266;
    }
    .player-extra {
      display: flex;
      gap: 30px;
      margin-top: 12px;
      color: #9a3b5f;
    }
    .player-extra button { background: none; border: none; color: #9a3b5f; font-size: 18px; cursor: pointer; }
    .close-player { position: absolute; top: 24px; right: 24px; background: none; border: none; color: white; font-size: 28px; cursor: pointer; }
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(4px);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: #151122;
      max-width: 340px;
      width: 100%;
      border-radius: 32px;
      padding: 24px;
      color: white;
      animation: fadeUp 0.3s;
    }
    .modal h3 { margin-bottom: 6px; }
    .modal .sub { color: #9a3b5f; margin-bottom: 16px; }
    .quality-option { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #2a1f3a; }
    .lib-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 12px;
    }
    .lib-card { background: #151122; border-radius: 20px; padding: 16px; text-align: center; }
    .lib-card i { font-size: 32px; color: #ff2f92; }
    .profile-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 12px 0;
    }
    .profile-avatar {
      width: 72px; height: 72px;
      background: #2a1f3a;
      border-radius: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      color: #ff2f92;
    }
    .stats {
      display: flex;
      gap: 20px;
      margin: 16px 0;
    }
    .stats div { text-align: center; color: white; }
    .stats span { color: #9a3b5f; font-size: 0.75rem; }
    .menu-item {
      padding: 14px 0;
      border-bottom: 1px solid #1f1830;
      color: white;
      display: flex;
      justify-content: space-between;
    }
    .toast {
      position: fixed;
      bottom: 100px;
      left: 20px;
      right: 20px;
      background: #151122;
      color: white;
      padding: 12px 20px;
      border-radius: 40px;
      text-align: center;
      max-width: 400px;
      margin: 0 auto;
      border-left: 4px solid #ff2f92;
      display: none;
      z-index: 2000;
    }
    .toast.show { display: block; }
    .flex-between { display: flex; justify-content: space-between; align-items: center; }
    .mt-8 { margin-top: 8px; }
    .mb-8 { margin-bottom: 8px; }
    .gap-8 { gap: 8px; }
    .text-muted { color: #9a3b5f; }

    /* UPLOAD SECTION */
    .upload-area {
      background: #151122;
      border: 2px dashed #2a1f3a;
      border-radius: 24px;
      padding: 24px 16px;
      text-align: center;
      margin: 16px 0;
      transition: 0.3s;
    }
    .upload-area.dragover { border-color: #ff2f92; background: #1f1830; }
    .upload-area i { font-size: 48px; color: #ff2f92; margin-bottom: 8px; }
    .upload-area p { color: #9a3b5f; margin-bottom: 12px; }
    .upload-area input[type="file"] { display: none; }
    .upload-progress {
      width: 100%;
      height: 4px;
      background: #2a1f3a;
      border-radius: 10px;
      margin: 12px 0;
      display: none;
    }
    .upload-progress .bar {
      height: 100%;
      background: linear-gradient(90deg, #ff2f92, #8b2cff);
      border-radius: 10px;
      width: 0%;
      transition: width 0.3s;
    }
    .uploaded-songs {
      margin-top: 12px;
    }
    .uploaded-song {
      background: #1f1830;
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: white;
    }
    .uploaded-song .info { flex: 1; }
    .uploaded-song .info .title { font-weight: 600; }
    .uploaded-song .info .artist { font-size: 0.75rem; color: #9a3b5f; }
    .uploaded-song .actions button { color: #9a3b5f; margin-left: 8px; }
  </style>
</head>
<body>
  <!-- RUN BUTTON -->
  <div class="run-wrapper">
