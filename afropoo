<script>
  (function(){
    // ----- DATA -----
    let songs = [
      { id: 1, title: "Sika Aba Fie", artist: "Kweku Darlington", cover: "🎵", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3", duration: "3:28", album: "Sika Aba Fie", category: "Afrobeats", isUpload: false },
      { id: 2, title: "Odo Nti", artist: "Stonebwyo", cover: "🎶", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3", duration: "3:15", album: "Odo", category: "Afrobeats", isUpload: false },
      { id: 3, title: "Jejereje", artist: "King Promise", cover: "🎧", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3", duration: "3:42", album: "Jejereje", category: "Afro", isUpload: false },
      { id: 4, title: "Terminator", artist: "King Promise", cover: "🔥", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3", duration: "3:20", album: "Terminator", category: "Afro", isUpload: false },
      { id: 5, title: "Aseda", artist: "KiDi", cover: "🌟", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3", duration: "3:50", album: "Aseda", category: "Afrobeats", isUpload: false },
      { id: 6, title: "CCTV", artist: "King Promise", cover: "📹", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-6.mp3", duration: "3:05", album: "CCTV", category: "Afro", isUpload: false },
      { id: 7, title: "Tokyo", artist: "King Promise", cover: "🗼", audio: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-7.mp3", duration: "3:30", album: "Tokyo", category: "Afro", isUpload: false },
    ];

    // Load uploaded songs from localStorage
    let uploadedSongs = JSON.parse(localStorage.getItem('afroUploads')) || [];
    // Merge uploaded songs with default songs (uploaded songs get IDs starting from 100)
    function getAllSongs() {
      const defaultSongs = songs.filter(s => !s.isUpload);
      return [...defaultSongs, ...uploadedSongs];
    }

    // state
    let currentSongIndex = 0;
    let isPlaying = false;
    let audio = new Audio();
    let currentSongId = null;
    let favorites = JSON.parse(localStorage.getItem('afroFavorites')) || [];
    let downloads = JSON.parse(localStorage.getItem('afroDownloads')) || [];
    let playlists = JSON.parse(localStorage.getItem('afroPlaylists')) || [{name:"My Favorites", songs:[]}];
    let recentlyPlayed = JSON.parse(localStorage.getItem('afroRecent')) || [];

    // DOM refs
    const appContainer = document.getElementById('app');
    const runBtn = document.getElementById('runAppBtn');
    const screens = document.querySelectorAll('.screen');
    const navItems = document.querySelectorAll('.nav-item');
    const splash = document.getElementById('splash');
    const homeScreen = document.getElementById('home');
    const player = document.getElementById('musicPlayer');
    const closePlayer = document.getElementById('closePlayer');
    const playerPlayBtn = document.getElementById('playerPlayBtn');
    const progressBar = document.getElementById('progressBar');
    const currentTimeSpan = document.getElementById('currentTime');
    const totalDurationSpan = document.getElementById('totalDuration');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const favBtn = document.getElementById('favBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const modal = document.getElementById('downloadModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const confirmDownloadBtn = document.getElementById('confirmDownloadBtn');
    const toast = document.getElementById('toast');
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');
    const favoritesList = document.getElementById('favoritesList');
    const downloadsList = document.getElementById('downloadsList');
    const downloadCount = document.getElementById('downloadCount');
    const storageEstimate = document.getElementById('storageEstimate');
    const profileFavs = document.getElementById('profileFavs');
    const profileDownloads = document.getElementById('profileDownloads');
    const profileUploads = document.getElementById('profileUploads');
    const favCount = document.getElementById('favCount');
    const playlistCount = document.getElementById('playlistCount');
    const uploadCount = document.getElementById('uploadCount');
    const uploadLibCount = document.getElementById('uploadLibCount');
    const uploadRow = document.getElementById('uploadRow');

    // ---- helpers ----
    function showScreen(id) {
      screens.forEach(s => s.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      if (id === 'library') renderLibrary();
      if (id === 'downloads') renderDownloads();
      if (id === 'profile') { 
        profileFavs.textContent = favorites.length; 
        profileDownloads.textContent = downloads.length;
        profileUploads.textContent = uploadedSongs.length;
      }
      if (id === 'home') renderAllCards();
    }

    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2200);
    }

    // render song cards
    function renderSongCards(containerId, songList) {
      const container = document.getElementById(containerId);
      container.innerHTML = '';
      if (!songList || songList.length === 0) {
        container.innerHTML = '<div class="text-muted" style="padding:12px 0;">No songs yet</div>';
        return;
      }
      songList.forEach(song => {
        const card = document.createElement('div');
        card.className = 'song-card';
        card.innerHTML = `
          <div class="cover">${song.cover || '🎵'}</div>
          <div class="title">${song.title}</div>
          <div class="artist">${song.artist}</div>
          <div class="actions">
            <button class="btn-icon play-card" data-id="${song.id}"><i class="fas fa-play"></i></button>
            <button class="btn-icon options-card" data-id="${song.id}"><i class="fas fa-ellipsis-v"></i></button>
          </div>
        `;
        container.appendChild(card);
      });
      container.querySelectorAll('.play-card').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = parseInt(btn.dataset.id);
          const allSongs = getAllSongs();
          const song = allSongs.find(s => s.id === id);
          if (song) playSong(song);
        });
      });
    }

    function renderAllCards() {
      const allSongs = getAllSongs();
      renderSongCards('newReleaseRow', allSongs.slice(0,3));
      renderSongCards('trendingRow', allSongs.slice(2,5));
      renderSongCards('recommendedRow', allSongs.slice(4,7));
      const uploads = uploadedSongs;
      renderSongCards('uploadRow', uploads);
      uploadCount.textContent = uploads.length;
      uploadLibCount.textContent = uploads.length;
    }

    // play song
    function playSong(song) {
      if (!song) return;
      currentSongId = song.id;
      document.getElementById('playerTitle').textContent = song.title;
      document.getElementById('playerArtist').textContent = song.artist;
      document.getElementById('playerArt').innerHTML = `<i class="fas fa-music"></i>`;
      audio.src = song.audio;
      audio.load();
      audio.play().catch(()=>{});
      isPlaying = true;
      playerPlayBtn.innerHTML = '<i class="fas fa-pause"></i>';
      player.classList.add('open');
      updateFavIcon();
      if (!recentlyPlayed.includes(song.id)) recentlyPlayed.push(song.id);
      if (recentlyPlayed.length > 20) recentlyPlayed.shift();
      localStorage.setItem('afroRecent', JSON.stringify(recentlyPlayed));
    }

    function updateFavIcon() {
      const isFav = favorites.includes(currentSongId);
      favBtn.innerHTML = isFav ? '<i class="fas fa-heart" style="color:#ff2f92;"></i>' : '<i class="far fa-heart"></i>';
    }

    function renderLibrary() {
      favCount.textContent = favorites.length;
      playlistCount.textContent = playlists.length;
      const allSongs = getAllSongs();
      const favSongs = allSongs.filter(s => favorites.includes(s.id));
      favoritesList.innerHTML = '';
      if (favSongs.length === 0) { favoritesList.innerHTML = '<div class="text-muted">No favorites yet</div>'; return; }
      favSongs.forEach(s => {
        const div = document.createElement('div');
        div.className = 'flex-between';
        div.style.padding = '6px 0';
        div.innerHTML = `<span>${s.title} - ${s.artist}</span><button class="btn-icon delete-fav" data-id="${s.id}" style="color:#ff2f92;"><i class="fas fa-heart"></i></button>`;
        div.querySelector('.delete-fav').addEventListener('click', (e) => {
          const id = parseInt(e.currentTarget.dataset.id);
          favorites = favorites.filter(f => f !== id);
          localStorage.setItem('afroFavorites', JSON.stringify(favorites));
          renderLibrary();
          updateFavIcon();
          showToast('Removed from favorites');
        });
        favoritesList.appendChild(div);
      });
    }

    function renderDownloads() {
      const allSongs = getAllSongs();
      const downloadedSongs = allSongs.filter(s => downloads.includes(s.id));
      downloadsList.innerHTML = '';
      if (downloadedSongs.length === 0) { downloadsList.innerHTML = '<div class="text-muted">No downloads yet</div>'; }
      downloadedSongs.forEach(s => {
        const div = document.createElement('div');
        div.className = 'flex-between';
        div.style.padding = '8px 0';
        div.style.borderBottom = '1px solid #1f1830';
        div.innerHTML = `
          <div><span>${s.title}</span><br><span class="text-muted" style="font-size:0.7rem;">${s.artist} • 3.5 MB</span></div>
          <div><button class="btn-icon play-download" data-id="${s.id}"><i class="fas fa-play"></i></button>
          <button class="btn-icon delete-download" data-id="${s.id}"><i class="fas fa-trash" style="color:#ff2f92;"></i></button></div>
        `;
        downloadsList.appendChild(div);
      });
      downloadCount.textContent = downloadedSongs.length + ' songs';
      storageEstimate.textContent = (downloadedSongs.length * 4.2).toFixed(1) + ' MB';
      downloadsList.querySelectorAll('.play-download').forEach(b => b.addEventListener('click', (e) => {
        const id = parseInt(e.currentTarget.dataset.id);
        const allSongs = getAllSongs();
        const song = allSongs.find(s => s.id === id);
        if (song) playSong(song);
      }));
      downloadsList.querySelectorAll('.delete-download').forEach(b => {
        b.addEventListener('click', (e) => {
          const id = parseInt(e.currentTarget.dataset.id);
          downloads = downloads.filter(d => d !== id);
          localStorage.setItem('afroDownloads', JSON.stringify(downloads));
          renderDownloads();
          showToast('Deleted download');
        });
      });
      profileDownloads.textContent = downloads.length;
    }

    // ---- UPLOAD SYSTEM ----
    function setupUpload() {
      let uploadArea = document.getElementById('uploadArea');
      if (!uploadArea) {
        const searchScreen = document.getElementById('search');
        const uploadHTML = `
          <div class="upload-area" id="uploadArea">
            <i class="fas fa-cloud-upload-alt"></i>
            <p>Upload your own music<br><span class="text-muted" style="font-size:0.8rem;">MP3, WAV, or OGG</span></p>
            <button class="btn-primary" id="uploadBtn"><i class="fas fa-plus"></i> Choose Files</button>
            <input type="file" id="fileInput" accept=".mp3,.wav,.ogg" multiple>
            <div class="upload-progress" id="uploadProgress"><div class="bar" id="progressBarUpload"></div></div>
          </div>
          <div class="uploaded-songs" id="uploadedSongsList"></div>
        `;
        const searchBar = document.querySelector('.search-bar');
        searchBar.insertAdjacentHTML('afterend', uploadHTML);
      }
      
      const fileInput = document.getElementById('fileInput');
      const uploadBtn = document.getElementById('uploadBtn');
      const progressBarUpload = document.getElementById('progressBarUpload');
      const uploadProgress = document.getElementById('uploadProgress');
      const uploadedSongsList = document.getElementById('uploadedSongsList');

      uploadBtn.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', (e) => {
        const files = e.target.files;
        if (files.length === 0) return;
        
        uploadProgress.style.display = 'block';
        let processed = 0;
        const total = files.length;

        Array.from(files).forEach((file, index) => {
          const reader = new FileReader();
          reader.onload = function(event) {
            const songId = 100 + uploadedSongs.length + index;
            const songName = file.name.replace(/\.[^/.]+$/, "");
            let title = songName;
            let artistName = "Unknown Artist";
            if (songName.includes(' - ')) {
              const parts = songName.split(' - ');
              artistName = parts[0].trim();
              title = parts[1].trim() || title;
            }
            
            const newSong = {
              id: songId,
              title: title,
              artist: artistName,
              cover: "🎤",
              audio: event.target.result,
              duration: "3:00",
              album: "Uploads",
              category: "Upload",
              isUpload: true
            };
            
            uploadedSongs.push(newSong);
            
            processed++;
            const pct = (processed / total) * 100;
            progressBarUpload.style.width = pct + '%';
            
            if (processed === total) {
              setTimeout(() => {
                uploadProgress.style.display = 'none';
                progressBarUpload.style.width = '0%';
                localStorage.setItem('afroUploads', JSON.stringify(uploadedSongs));
                renderAllCards();
                renderLibrary();
                showToast(`Uploaded ${total} song${total > 1 ? 's' : ''}!`);
                fileInput.value = '';
                renderUploadedList();
              }, 500);
            }
          };
          reader.readAsDataURL(file);
        });
      });

      const uploadArea = document.getElementById('uploadArea');
      uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.classList.add('dragover');
      });
      uploadArea.addEventListener('dragleave', () => {
        uploadArea.classList.remove('dragover');
      });
      uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadArea.classList.remove('dragover');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
          fileInput.files = files;
          fileInput.dispatchEvent(new Event('change'));
        }
      });

      renderUploadedList();
    }

    function renderUploadedList() {
      const container = document.getElementById('uploadedSongsList');
      if (!container) return;
      container.innerHTML = '';
      if (uploadedSongs.length === 0) {
        container.innerHTML = '<div class="text-muted" style="padding:8px 0;">No uploaded songs yet</div>';
        return;
      }
      uploadedSongs.forEach((song) => {
        const div = document.createElement('div');
        div.className = 'uploaded-song';
        div.innerHTML = `
          <div class="info">
            <div class="title">${song.title}</div>
            <div class="artist">${song.artist}</div>
          </div>
          <div class="actions">
            <button class="btn-icon play-upload" data-id="${song.id}"><i class="fas fa-play"></i></button>
            <button class="btn-icon delete-upload" data-id="${song.id}"><i class="fas fa-trash" style="color:#ff2f92;"></i></button>
          </div>
        `;
        container.appendChild(div);
      });
      container.querySelectorAll('.play-upload').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = parseInt(e.currentTarget.dataset.id);
          const song = uploadedSongs.find(s => s.id === id);
          if (song) playSong(song);
        });
      });
      container.querySelectorAll('.delete-upload').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = parseInt(e.currentTarget.dataset.id);
          // Delete from uploadedSongs
          uploadedSongs = uploadedSongs.filter(s => s.id !== id);
          localStorage.setItem('afroUploads', JSON.stringify(uploadedSongs));
          renderAllCards();
          renderLibrary();
          renderUploadedList();
          showToast('Deleted uploaded song');
        });
      });
    }

    // ---- navigation ----
    navItems.forEach(item => {
      item.addEventListener('click', () => {
        navItems.forEach(n => n.classList.remove('active'));
        item.classList.add('active');
        const screenId = item.dataset.screen;
        showScreen(screenId);
        if (screenId === 'search') setupUpload();
      });
    });

    // ---- RUN APP ----
    runBtn.addEventListener('click', () => {
      appContainer.classList.add('open');
      runBtn.style.display = 'none';
      setTimeout(() => {
        splash.style.display = 'none';
        showScreen('home');
      }, 2000);
      renderAllCards();
      renderLibrary();
      renderDownloads();
      profileFavs.textContent = favorites.length;
      profileDownloads.textContent = downloads.length;
      profileUploads.textContent = uploadedSongs.length;
      setupUpload();
    });

    // ---- player controls ----
    closePlayer.addEventListener('click', () => player.classList.remove('open'));

    playerPlayBtn.addEventListener('click', () => {
      if (isPlaying) {
        audio.pause();
        playerPlayBtn.innerHTML = '<i class="fas fa-play"></i>';
        isPlaying = false;
      } else {
        audio.play().catch(()=>{});
        playerPlayBtn.innerHTML = '<i class="fas fa-pause"></i>';
        isPlaying = true;
      }
    });

    audio.addEventListener('timeupdate', () => {
      if (audio.duration) {
        const pct = (audio.currentTime / audio.duration) * 100;
        progressBar.value = pct;
        currentTimeSpan.textContent = formatTime(audio.currentTime);
        totalDurationSpan.textContent = formatTime(audio.duration);
      }
    });

    progressBar.addEventListener('input', (e) => {
      if (audio.duration) {
        const pct = parseFloat(e.target.value) / 100;
        audio.currentTime = pct * audio.duration;
      }
    });

    function formatTime(sec) {
      if (!sec) return '0:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m}:${s < 10 ? '0' : ''}${s}`;
    }

    prevBtn.addEventListener('click', () => {
      const allSongs = getAllSongs();
      const idx = allSongs.findIndex(s => s.id === currentSongId);
      if (idx > 0) playSong(allSongs[idx-1]);
    });
    nextBtn.addEventListener('click', () => {
      const allSongs = getAllSongs();
      const idx = allSongs.findIndex(s => s.id === currentSongId);
      if (idx < allSongs.length-1) playSong(allSongs[idx+1]);
    });

    favBtn.addEventListener('click', () => {
      if (!currentSongId) return;
      if (favorites.includes(currentSongId)) {
        favorites = favorites.filter(f => f !== currentSongId);
        showToast('Removed from favorites');
      } else {
        favorites.push(currentSongId);
        showToast('Added to favorites');
      }
      localStorage.setItem('afroFavorites', JSON.stringify(favorites));
      updateFavIcon();
      renderLibrary();
    });

    downloadBtn.addEventListener('click', () => {
      const allSongs = getAllSongs();
      const song = allSongs.find(s => s.id === currentSongId);
      if (!song) return;
      document.getElementById('modalSongTitle').textContent = song.title;
      document.getElementById('modalArtist').textContent = song.artist;
      modal.classList.add('open');
    });

    closeModalBtn.addEventListener('click', () => modal.classList.remove('open'));
    confirmDownloadBtn.addEventListener('click', () => {
      const allSongs = getAllSongs();
      const song = allSongs.find(s => s.id === currentSongId);
      if (song && !downloads.includes(song.id)) {
        downloads.push(song.id);
        localStorage.setItem('afroDownloads', JSON.stringify(downloads));
        showToast('Downloaded ' + song.title);
        renderDownloads();
      } else {
        showToast('Already downloaded');
      }
      modal.classList.remove('open');
    });

    // ---- ENHANCED SEARCH with filterSongs function ----
    function filterSongs(searchTerm) {
      const allSongs = getAllSongs();
      if (!searchTerm || searchTerm.trim() === '') {
        searchResults.innerHTML = '<div class="text-muted">Type to search...</div>';
        return;
      }
      const filtered = allSongs.filter(s => 
        s.title.toLowerCase().includes(searchTerm.toLowerCase()) || 
        s.artist.toLowerCase().includes(searchTerm.toLowerCase())
      );
      if (filtered.length === 0) {
        searchResults.innerHTML = '<div class="text-muted">No results found</div>';
        return;
      }
      searchResults.innerHTML = filtered.map(s => 
        `<div class="flex-between" style="padding:6px 0;border-bottom:1px solid #1f1830;">
          <span>${s.title} - ${s.artist}</span>
          <button class="btn-icon play-card" data-id="${s.id}"><i class="fas fa-play"></i></button>
        </div>`
      ).join('');
      searchResults.querySelectorAll('.play-card').forEach(b => {
        b.addEventListener('click', (e) => {
          const id = parseInt(e.currentTarget.dataset.id);
          const allSongs = getAllSongs();
          const song = allSongs.find(s => s.id === id);
          if (song) playSong(song);
        });
      });
    }

    // Attach search input listener
    searchInput.addEventListener('input', function(e) {
      filterSongs(e.target.value);
    });

    // ---- DOWNLOAD FUNCTION (async) ----
    async function downloadSong(songUrl, fileName) {
      try {
        const response = await fetch(songUrl, {
          mode: 'cors'
        });
        const blob = await response.blob();
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = fileName || 'song.mp3';
        link.click();
        URL.revokeObjectURL(link.href);
        showToast('Download started!');
      } catch (error) {
        console.error('Download failed:', error);
        // Fallback: open in new tab
        window.open(songUrl, '_blank');
        showToast('Opening in new tab...');
      }
    }

    // ---- SAVE SONG TO PLAYLIST (localStorage) ----
    function saveSongToPlaylist(songData) {
      let playlist = JSON.parse(localStorage.getItem('playlist')) || [];
      // Check if song already exists
      if (!playlist.some(s => s.id === songData.id)) {
        playlist.push(songData);
        localStorage.setItem('playlist', JSON.stringify(playlist));
        showToast('Added to playlist!');
        renderLibrary();
      } else {
        showToast('Song already in playlist');
      }
    }

    // ---- DELETE SONG FROM PLAYLIST ----
    function deleteSongFromPlaylist(songId) {
      let playlist = JSON.parse(localStorage.getItem('playlist')) || [];
      playlist = playlist.filter(song => song.id !== songId);
      localStorage.setItem('playlist', JSON.stringify(playlist));
      renderLibrary();
      showToast('Removed from playlist');
    }

    // ---- EXTRA: Add to playlist from player ----
    document.getElementById('addPlaylistBtn').addEventListener('click', () => {
      const allSongs = getAllSongs();
      const song = allSongs.find(s => s.id === currentSongId);
      if (song) {
        saveSongToPlaylist(song);
      } else {
        showToast('No song playing');
      }
    });

    // ---- OPTIONS CARD HANDLER ----
    document.querySelectorAll('.options-card').forEach(b => {
      b.addEventListener('click', (e) => {
        const id = parseInt(e.currentTarget.dataset.id);
        const allSongs = getAllSongs();
        const song = allSongs.find(s => s.id === id);
        if (song) {
          showToast(`Options for ${song.title} - Add to playlist?`);
          // Quick add to playlist via options
          saveSongToPlaylist(song);
        }
      });
    });

    audio.addEventListener('ended', () => {
      isPlaying = false;
      playerPlayBtn.innerHTML = '<i class="fas fa-play"></i>';
    });

  })();
</script>
</body>
</html>